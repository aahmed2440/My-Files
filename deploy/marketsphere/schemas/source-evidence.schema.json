{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketsphere.local/schema/source-evidence-v1.json",
  "title": "MarketSphere Empirical Market-Source Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "classification",
    "simulated",
    "source_id",
    "provider",
    "service",
    "instrument",
    "authentication",
    "subscription",
    "connection",
    "first_data_at",
    "source_ts",
    "recv_ts",
    "heartbeat_at",
    "messages_received",
    "freshness_ms",
    "heartbeat_age_ms",
    "timestamp_integrity",
    "sequence_integrity",
    "sequence_gaps",
    "provenance",
    "proof_window_start",
    "proof_window_end"
  ],
  "properties": {
    "classification": { "const": "EMPIRICAL_MARKET_SOURCE_EVIDENCE" },
    "simulated": { "const": false },
    "source_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "service": { "type": "string", "minLength": 1 },
    "instrument": { "type": "string", "minLength": 1 },
    "authentication": { "const": "VERIFIED" },
    "subscription": { "const": "ACK" },
    "connection": { "const": "CONNECTED" },
    "first_data_at": { "type": "string", "format": "date-time" },
    "source_ts": { "type": "string", "format": "date-time" },
    "recv_ts": { "type": "string", "format": "date-time" },
    "heartbeat_at": { "type": "string", "format": "date-time" },
    "messages_received": { "type": "integer", "minimum": 1 },
    "freshness_ms": { "type": "number", "minimum": 0 },
    "heartbeat_age_ms": { "type": "number", "minimum": 0 },
    "timestamp_integrity": { "const": true },
    "sequence_integrity": { "const": true },
    "sequence_gaps": { "const": 0 },
    "provenance": { "type": "string", "minLength": 8 },
    "proof_window_start": { "type": "string", "format": "date-time" },
    "proof_window_end": { "type": "string", "format": "date-time" }
  }
}
